{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Roadmap Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "roadmap_id",
    "project_id",
    "requirement_spec_id",
    "requirement_full_hash",
    "brainstorming_id",
    "brainstorming_full_hash",
    "version",
    "status",
    "title",
    "summary",
    "milestones",
    "content_hash"
  ],
  "properties": {
    "roadmap_id": { "type": "string" },
    "project_id": { "type": "string" },
    "requirement_spec_id": { "type": "string" },
    "requirement_version": { "type": "string" },
    "requirement_full_hash": { "type": "string" },
    "brainstorming_id": { "type": "string" },
    "brainstorming_version": { "type": "string" },
    "brainstorming_full_hash": { "type": "string" },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ANALYZING",
        "MILESTONES_DEFINED",
        "DEPENDENCIES_MAPPED",
        "READY_FOR_REVIEW",
        "REVIEWED",
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "NEEDS_CHANGES",
        "BLOCKED",
        "SUPERSEDED",
        "CANCELLED"
      ]
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "selected_option": { "type": "string" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["milestone_id", "title", "objective", "outcome", "exit_criteria", "dependencies", "status"],
        "properties": {
          "milestone_id": { "type": "string" },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "outcome": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "entry_conditions": { "type": "array", "items": { "type": "string" } },
          "exit_criteria": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "required_gates": { "type": "array", "items": { "type": "string" } },
          "owner_role": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dependency_id", "type", "source_milestone", "target_milestone", "blocking"],
        "properties": {
          "dependency_id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "HARD_DEPENDENCY",
              "SOFT_DEPENDENCY",
              "APPROVAL_DEPENDENCY",
              "ARTIFACT_DEPENDENCY",
              "EXTERNAL_DEPENDENCY",
              "DATA_DEPENDENCY",
              "INFRASTRUCTURE_DEPENDENCY",
              "MIGRATION_DEPENDENCY"
            ]
          },
          "source_milestone": { "type": "string" },
          "target_milestone": { "type": "string" },
          "description": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "major_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exit_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" }
  }
}
