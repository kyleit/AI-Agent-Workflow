{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Roadmap and Plan Handoff Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "requirement_identity",
    "brainstorming_identity",
    "roadmap_identity",
    "plan_identity",
    "selected_option",
    "collaboration_mode",
    "readiness_status",
    "architecture_review_status"
  ],
  "properties": {
    "requirement_identity": {
      "type": "object",
      "required": ["spec_id", "full_hash"],
      "properties": {
        "spec_id": { "type": "string" },
        "full_hash": { "type": "string" }
      }
    },
    "brainstorming_identity": {
      "type": "object",
      "required": ["artifact_id", "full_hash"],
      "properties": {
        "artifact_id": { "type": "string" },
        "full_hash": { "type": "string" }
      }
    },
    "roadmap_identity": {
      "type": "object",
      "required": ["roadmap_id", "full_hash"],
      "properties": {
        "roadmap_id": { "type": "string" },
        "full_hash": { "type": "string" }
      }
    },
    "plan_identity": {
      "type": "object",
      "required": ["plan_id", "full_hash"],
      "properties": {
        "plan_id": { "type": "string" },
        "full_hash": { "type": "string" }
      }
    },
    "selected_option": { "type": "string" },
    "collaboration_mode": { "type": "string" },
    "readiness_status": { "type": "string" },
    "architecture_review_status": { "type": "string" },
    "tasks_summary": { "type": "array", "items": { "type": "string" } },
    "expected_file_impacts": { "type": "array", "items": { "type": "string" } }
  }
}
