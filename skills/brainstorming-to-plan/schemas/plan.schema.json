{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Execution Plan Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "plan_id",
    "project_id",
    "requirement_spec_id",
    "requirement_full_hash",
    "brainstorming_id",
    "brainstorming_full_hash",
    "roadmap_id",
    "roadmap_full_hash",
    "version",
    "status",
    "title",
    "tasks",
    "collaboration_mode",
    "safe_write_strategy",
    "verification_strategy",
    "content_hash"
  ],
  "properties": {
    "plan_id": { "type": "string" },
    "project_id": { "type": "string" },
    "requirement_spec_id": { "type": "string" },
    "requirement_full_hash": { "type": "string" },
    "brainstorming_id": { "type": "string" },
    "brainstorming_full_hash": { "type": "string" },
    "roadmap_id": { "type": "string" },
    "roadmap_version": { "type": "string" },
    "roadmap_full_hash": { "type": "string" },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "DECOMPOSING",
        "OWNERS_ASSIGNING",
        "DEPENDENCIES_VALIDATING",
        "READY_FOR_REVIEW",
        "REVIEWED",
        "AWAITING_ARCHITECTURE_REVIEW",
        "ARCHITECTURE_APPROVED",
        "ARCHITECTURE_APPROVED_WITH_CONDITIONS",
        "NEEDS_CHANGES",
        "BLOCKED",
        "SUPERSEDED",
        "CANCELLED"
      ]
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "collaboration_mode": {
      "type": "string",
      "enum": [
        "MODE_A_SINGLE_AGENT",
        "MODE_B_MULTI_AGENT_SINGLE_WRITER",
        "MODE_C_SAFE_MULTI_WRITE"
      ],
      "default": "MODE_B_MULTI_AGENT_SINGLE_WRITER"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "objective",
          "owner_role",
          "assigned_agent",
          "dependencies",
          "expected_files",
          "verification",
          "status"
        ],
        "properties": {
          "task_id": { "type": "string" },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "description": { "type": "string" },
          "owner_role": { "type": "string" },
          "assigned_agent": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "expected_files": { "type": "array", "items": { "type": "string" } },
          "expected_modules": { "type": "array", "items": { "type": "string" } },
          "verification": {
            "type": "object",
            "required": ["verification_type", "owner"],
            "properties": {
              "verification_type": { "type": "string" },
              "owner": { "type": "string" },
              "approval_required": { "type": "boolean" }
            }
          },
          "rollback": {
            "type": "object",
            "properties": {
              "trigger": { "type": "string" },
              "steps": { "type": "string" }
            }
          },
          "status": {
            "type": "string",
            "enum": ["PLANNED", "READY", "BLOCKED", "DEFERRED", "CANCELLED"]
          }
        }
      }
    },
    "safe_write_strategy": {
      "type": "object",
      "required": ["single_writer", "file_ownership"],
      "properties": {
        "single_writer": { "type": "boolean" },
        "file_ownership": { "type": "string" },
        "write_order": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification_strategy": {
      "type": "object",
      "required": ["test_execution_owner"],
      "properties": {
        "test_execution_owner": { "type": "string", "default": "TESTER" },
        "static_validation_required": { "type": "boolean", "default": true },
        "build_verification_required": { "type": "boolean", "default": true }
      }
    },
    "rollback_strategy": {
      "type": "object",
      "properties": {
        "high_risk_tasks_rollback": { "type": "array", "items": { "type": "string" } }
      }
    },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" }
  }
}
