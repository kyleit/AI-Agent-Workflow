{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Cross-Skill Route Graph Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "graph_id",
    "canonical_entrypoint",
    "status"
  ],
  "properties": {
    "graph_id": { "type": "string" },
    "canonical_entrypoint": { "type": "string", "default": "workflow-coordinator" },
    "nodes_count": { "type": "integer" },
    "edges_count": { "type": "integer" },
    "status": { "type": "string", "default": "GRAPH_VALIDATED" }
  }
}
