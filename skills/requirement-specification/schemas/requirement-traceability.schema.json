{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Requirement Traceability Matrix Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "traceability_id",
    "requirement_spec_id",
    "intent_id",
    "traceability_chain"
  ],
  "properties": {
    "traceability_id": { "type": "string" },
    "requirement_spec_id": { "type": "string" },
    "intent_id": { "type": "string" },
    "traceability_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "raw_intent_id",
          "normalized_intent_id",
          "goal_id",
          "use_case_id",
          "requirement_id",
          "acceptance_criteria_id"
        ],
        "properties": {
          "raw_intent_id": { "type": "string" },
          "normalized_intent_id": { "type": "string" },
          "goal_id": { "type": "string" },
          "use_case_id": { "type": "string" },
          "requirement_id": { "type": "string" },
          "acceptance_criteria_id": { "type": "string" }
        }
      }
    }
  }
}
