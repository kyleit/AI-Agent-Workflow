{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Implementation Execution Session Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "execution_id",
    "project_id",
    "workflow_id",
    "requirement_identity",
    "brainstorming_identity",
    "roadmap_identity",
    "plan_identity",
    "blueprint_identity",
    "blueprint_freeze_identity",
    "implementation_approval_identity",
    "version",
    "status",
    "baseline_commit",
    "collaboration_mode",
    "main_writer",
    "allowed_files",
    "protected_files",
    "change_ledger",
    "content_hash"
  ],
  "properties": {
    "execution_id": { "type": "string" },
    "project_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "session_id": { "type": "string" },
    "requirement_identity": { "type": "object" },
    "brainstorming_identity": { "type": "object" },
    "roadmap_identity": { "type": "object" },
    "plan_identity": { "type": "object" },
    "blueprint_identity": { "type": "object" },
    "blueprint_freeze_identity": { "type": "object" },
    "implementation_approval_identity": { "type": "object" },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "ENTRY_VALIDATING",
        "AUTHORIZED",
        "SESSION_INITIALIZING",
        "TASKS_LOADING",
        "READY",
        "EXECUTING",
        "PAUSED",
        "BLOCKED",
        "RECOVERING",
        "ROLLING_BACK",
        "IMPLEMENTATION_REVIEW",
        "COMPLETED",
        "COMPLETED_WITH_FINDINGS",
        "FAILED",
        "CANCELLED",
        "INVALIDATED",
        "SUPERSEDED"
      ]
    },
    "baseline_commit": { "type": "string" },
    "collaboration_mode": { "type": "string", "default": "MODE_B_MULTI_AGENT_SINGLE_WRITER" },
    "main_writer": { "type": "string", "default": "Main Writer" },
    "allowed_files": { "type": "array", "items": { "type": "string" } },
    "protected_files": { "type": "array", "items": { "type": "string" } },
    "generated_files": { "type": "array", "items": { "type": "string" } },
    "mirror_files": { "type": "array", "items": { "type": "string" } },
    "change_ledger": { "type": "array", "items": { "type": "object" } },
    "execution_records": { "type": "array", "items": { "type": "object" } },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" }
  }
}
