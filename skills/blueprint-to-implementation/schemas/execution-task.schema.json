{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Execution Task Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "task_id",
    "blueprint_step_id",
    "plan_task_id",
    "title",
    "objective",
    "owner_role",
    "assigned_agent",
    "writer_owner",
    "allowed_files",
    "protected_files",
    "status"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "blueprint_step_id": { "type": "string" },
    "plan_task_id": { "type": "string" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "owner_role": { "type": "string" },
    "assigned_agent": { "type": "string" },
    "writer_owner": { "type": "string", "default": "Main Writer" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "allowed_files": { "type": "array", "items": { "type": "string" } },
    "protected_files": { "type": "array", "items": { "type": "string" } },
    "base_hashes": { "type": "object" },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "ASSIGNED",
        "IN_PROGRESS",
        "PAUSED",
        "BLOCKED",
        "IMPLEMENTED",
        "IMPLEMENTED_WITH_FINDINGS",
        "FAILED",
        "ROLLED_BACK",
        "CANCELLED",
        "SUPERSEDED"
      ]
    },
    "evidence": { "type": "object" }
  }
}
