{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIWFImplementationEntryReceipt",
  "description": "Canonical schema for Implementation Entry Receipt persisted under docs/aiwf-runs/<workflow-id>/06-implementation/implementation-entry-receipt.json",
  "type": "object",
  "required": [
    "workflow_id",
    "feature_id",
    "blueprint_id",
    "blueprint_version",
    "blueprint_full_sha256",
    "code_block_gate_id",
    "code_block_gate_decision",
    "blueprint_approval_id",
    "implementation_approval_id",
    "implementation_phase",
    "allowed_files",
    "protected_files",
    "main_writer",
    "collaboration_mode",
    "source_write_allowed",
    "created_at",
    "content_hash",
    "hash_algorithm"
  ],
  "properties": {
    "workflow_id": { "type": "string" },
    "feature_id": { "type": "string" },
    "blueprint_id": { "type": "string" },
    "blueprint_version": { "type": "string" },
    "blueprint_full_sha256": { "type": "string" },
    "code_block_gate_id": { "type": "string" },
    "code_block_gate_decision": { "type": "string", "const": "PASS" },
    "blueprint_approval_id": { "type": "string" },
    "implementation_approval_id": { "type": "string" },
    "implementation_phase": { "type": "string" },
    "allowed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "protected_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "main_writer": { "type": "string" },
    "collaboration_mode": { "type": "string", "const": "MODE_B_MULTI_AGENT_SINGLE_WRITER" },
    "source_write_allowed": { "type": "boolean" },
    "created_at": { "type": "string" },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "const": "SHA-256" }
  },
  "additionalProperties": false
}
