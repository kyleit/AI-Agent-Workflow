{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIWFCommandReceipt",
  "description": "Canonical schema for machine-readable AIWF Command Receipt persisted after every command execution",
  "type": "object",
  "required": [
    "command_receipt_id",
    "schema_version",
    "command_id",
    "command",
    "arguments",
    "raw_request_sha256",
    "invocation",
    "wrapper_skill",
    "bootstrap_receipt_id",
    "bootstrap_receipt_sha256",
    "bootstrap_mode",
    "initialize_workflow_invoked",
    "repository_root",
    "repository_name",
    "repository_identity",
    "path_base",
    "project_id",
    "workflow_id",
    "workflow_variant",
    "state_authority",
    "state_version_before",
    "state_version_after",
    "state_hash_before",
    "state_hash_after",
    "previous_phase",
    "current_phase",
    "previous_state",
    "current_state",
    "gate_before",
    "gate_after",
    "result",
    "result_reason",
    "state_changed",
    "workflow_state_mutated",
    "audit_write_only",
    "source_changed",
    "files_changed",
    "handoff_references",
    "artifact_references",
    "approval_references",
    "blocking_findings",
    "pending_approval",
    "test_execution_authorized",
    "test_executed",
    "git_write_authorized",
    "git_executed",
    "release_authorized",
    "release_executed",
    "deploy_authorized",
    "deploy_executed",
    "next_allowed_action",
    "recommended_next_command",
    "previous_command_receipt_id",
    "previous_command_receipt_sha256",
    "started_at",
    "completed_at",
    "persisted_at",
    "receipt_path",
    "path_sanitization_status",
    "absolute_paths_detected",
    "absolute_paths_remaining",
    "content_hash",
    "hash_algorithm"
  ],
  "properties": {
    "command_receipt_id": { "type": "string" },
    "schema_version": { "type": "string", "const": "3.16.0" },
    "command_id": { "type": "string" },
    "command": { "type": "string" },
    "arguments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_request_sha256": { "type": "string" },
    "invocation": { "type": "string" },
    "wrapper_skill": { "type": "string", "const": "aiwf" },
    "bootstrap_receipt_id": { "type": "string" },
    "bootstrap_receipt_sha256": { "type": "string" },
    "bootstrap_mode": { "type": "string" },
    "initialize_workflow_invoked": { "type": "boolean", "const": true },
    "repository_root": { "type": "string", "const": "." },
    "repository_name": { "type": "string" },
    "repository_identity": { "type": "string" },
    "path_base": { "type": "string", "const": "REPOSITORY_ROOT" },
    "project_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "workflow_variant": { "type": "string" },
    "state_authority": { "type": "string", "const": ".agents/state" },
    "state_version_before": { "type": "string" },
    "state_version_after": { "type": "string" },
    "state_hash_before": { "type": "string" },
    "state_hash_after": { "type": "string" },
    "previous_phase": { "type": "string" },
    "current_phase": { "type": "string" },
    "previous_state": { "type": "string" },
    "current_state": { "type": "string" },
    "gate_before": { "type": "string" },
    "gate_after": { "type": "string" },
    "result": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "COMPLETED_WITH_CONDITIONS",
        "NO_CHANGE",
        "BLOCKED",
        "AWAITING_APPROVAL",
        "CANCELLED",
        "RECOVERED",
        "FAILED",
        "PERSISTENCE_FAILED",
        "PATH_SANITIZATION_FAILED"
      ]
    },
    "result_reason": { "type": "string" },
    "state_changed": { "type": "boolean" },
    "workflow_state_mutated": { "type": "boolean" },
    "audit_write_only": { "type": "boolean" },
    "source_changed": { "type": "boolean" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff_references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifact_references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approval_references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pending_approval": { "type": ["string", "null"] },
    "test_execution_authorized": { "type": "boolean" },
    "test_executed": { "type": "boolean" },
    "git_write_authorized": { "type": "boolean" },
    "git_executed": { "type": "boolean" },
    "release_authorized": { "type": "boolean" },
    "release_executed": { "type": "boolean" },
    "deploy_authorized": { "type": "boolean" },
    "deploy_executed": { "type": "boolean" },
    "next_allowed_action": { "type": "string" },
    "recommended_next_command": { "type": "string" },
    "previous_command_receipt_id": { "type": "string" },
    "previous_command_receipt_sha256": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "persisted_at": { "type": "string" },
    "receipt_path": { "type": "string" },
    "path_sanitization_status": { "type": "string", "enum": ["PASS", "FAILED"] },
    "absolute_paths_detected": { "type": "integer" },
    "absolute_paths_remaining": { "type": "integer", "const": 0 },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "const": "SHA-256" }
  },
  "additionalProperties": false
}
