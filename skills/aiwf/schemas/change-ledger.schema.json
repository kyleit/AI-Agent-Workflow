{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIWFChangeLedger",
  "description": "Canonical schema for change-ledger.json generated after every source code modification",
  "type": "object",
  "required": [
    "workflow_id",
    "feature_id",
    "phase_id",
    "total_changes",
    "changes",
    "path_base",
    "last_updated_at",
    "content_hash",
    "hash_algorithm"
  ],
  "properties": {
    "workflow_id": { "type": "string" },
    "feature_id": { "type": "string" },
    "phase_id": { "type": "string" },
    "total_changes": { "type": "integer" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "task_id",
          "blueprint_step_id",
          "requirement_ids",
          "acceptance_criteria_ids",
          "path",
          "operation",
          "before_full_sha256",
          "after_full_sha256",
          "summary",
          "writer",
          "risk",
          "rollback",
          "status"
        ],
        "properties": {
          "change_id": { "type": "string" },
          "task_id": { "type": "string" },
          "blueprint_step_id": { "type": "string" },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance_criteria_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "path": { "type": "string" },
          "operation": { "type": "string", "enum": ["CREATE", "MODIFY", "DELETE", "RENAME", "GENERATE"] },
          "before_full_sha256": { "type": "string" },
          "after_full_sha256": { "type": "string" },
          "summary": { "type": "string" },
          "writer": { "type": "string" },
          "risk": { "type": "string" },
          "rollback": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "path_base": { "type": "string", "const": "REPOSITORY_ROOT" },
    "last_updated_at": { "type": "string" },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "const": "SHA-256" }
  },
  "additionalProperties": false
}
