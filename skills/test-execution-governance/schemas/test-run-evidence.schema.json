{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Test Run Evidence Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "test_run_id",
    "test_entry_id",
    "tester",
    "status"
  ],
  "properties": {
    "test_run_id": { "type": "string" },
    "test_entry_id": { "type": "string" },
    "tester": { "type": "string", "default": "TESTER" },
    "command_or_method": { "type": "string" },
    "exit_code": { "type": "integer" },
    "status": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "ERROR",
        "TIMEOUT",
        "CANCELLED",
        "BLOCKED",
        "INCONCLUSIVE",
        "SKIPPED"
      ]
    },
    "evidence_hash": { "type": "string" }
  }
}
