{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Git and Release Readiness Handoff Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "git_release_readiness_handoff_id",
    "final_verification_identity",
    "architecture_conformance_identity",
    "test_status",
    "candidate_status",
    "content_hash"
  ],
  "properties": {
    "git_release_readiness_handoff_id": { "type": "string" },
    "final_verification_identity": { "type": "object" },
    "architecture_conformance_identity": { "type": "object" },
    "test_status": { "type": "string", "default": "NOT_RUN" },
    "acceptance_summary": { "type": "object" },
    "git_actions_authorized": { "type": "array", "items": { "type": "string" }, "default": [] },
    "release_authorized": { "type": "boolean", "default": false },
    "candidate_status": {
      "type": "string",
      "enum": [
        "NOT_READY",
        "READY_FOR_GIT_REVIEW",
        "READY_WITH_CONDITIONS",
        "BLOCKED"
      ]
    },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" }
  }
}
