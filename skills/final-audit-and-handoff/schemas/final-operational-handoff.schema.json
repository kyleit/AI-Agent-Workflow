{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Final Operational Handoff Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "handoff_id",
    "workflow_version",
    "status"
  ],
  "properties": {
    "handoff_id": { "type": "string" },
    "workflow_version": { "type": "string", "default": "3.15.0" },
    "workflow_operational_status": { "type": "string", "default": "OPERATIONAL_ACTIVE_WITH_CONDITIONS" },
    "status": { "type": "string", "default": "HANDOFF_COMPLETE" }
  }
}
