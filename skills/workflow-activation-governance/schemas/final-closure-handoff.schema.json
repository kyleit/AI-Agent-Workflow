{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Final Closure Handoff Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "final_closure_handoff_id",
    "workflow_version",
    "workflow_redesign_closed",
    "status"
  ],
  "properties": {
    "final_closure_handoff_id": { "type": "string" },
    "workflow_version": { "type": "string", "default": "3.15.0" },
    "workflow_redesign_closed": { "type": "boolean", "default": true },
    "status": { "type": "string", "default": "REDESIGN_CLOSED" },
    "next_implementation_phase": { "type": "null", "default": null }
  }
}
