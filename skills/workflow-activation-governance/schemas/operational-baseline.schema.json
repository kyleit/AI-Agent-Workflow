{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Operational Baseline Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "operational_baseline_id",
    "workflow_version",
    "canonical_entrypoint",
    "status",
    "content_hash"
  ],
  "properties": {
    "operational_baseline_id": { "type": "string" },
    "workflow_version": { "type": "string", "default": "3.15.0" },
    "canonical_entrypoint": { "type": "string", "default": "workflow-coordinator" },
    "canonical_entrypoint_count": { "type": "integer", "default": 1 },
    "mirror_state": { "type": "string", "default": "MIRROR_STALE" },
    "status": { "type": "string", "default": "BASELINE_CAPTURED" },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" }
  }
}
