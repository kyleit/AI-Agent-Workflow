{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIWFBootstrapReceipt",
  "description": "Formal schema for machine-readable AIWF Bootstrap Receipt generated by initialize-workflow",
  "type": "object",
  "required": [
    "bootstrap_receipt_id",
    "bootstrap_version",
    "command_id",
    "command",
    "mode",
    "wrapper_skill",
    "bootstrap_skill",
    "repository_root",
    "repository_root_method",
    "repository_identity",
    "current_commit",
    "current_branch",
    "state_authority",
    "state_path",
    "state_exists",
    "state_loaded",
    "state_version",
    "state_integrity",
    "project_id",
    "workflow_id",
    "workflow_action",
    "last_checkpoint",
    "checkpoint_validation",
    "approval_validation",
    "duplicate_workflow_check",
    "duplicate_orchestrator_check",
    "read_only",
    "created_at",
    "decision",
    "blocking_findings",
    "content_hash",
    "hash_algorithm"
  ],
  "properties": {
    "bootstrap_receipt_id": { "type": "string" },
    "bootstrap_version": { "type": "string" },
    "command_id": { "type": "string" },
    "invocation": { "type": "string" },
    "command": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": [
        "NEW_REQUEST",
        "RESUME",
        "STATUS_READ_ONLY",
        "HELP_READ_ONLY",
        "NEXT",
        "CONTINUE",
        "DEBUG",
        "VERIFY",
        "CANCEL",
        "RECOVER"
      ]
    },
    "wrapper_skill": { "type": "string", "const": "aiwf" },
    "bootstrap_skill": { "type": "string", "const": "initialize-workflow" },
    "repository_root": { "type": "string" },
    "repository_root_method": { "type": "string", "const": "git rev-parse --show-toplevel" },
    "repository_identity": { "type": "string" },
    "current_commit": { "type": "string" },
    "current_branch": { "type": "string" },
    "state_authority": { "type": "string", "const": ".agents/state" },
    "state_path": { "type": "string" },
    "state_exists": { "type": "boolean" },
    "state_loaded": { "type": "boolean" },
    "state_version": { "type": "string" },
    "state_integrity": { "type": "string" },
    "project_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "workflow_action": {
      "type": "string",
      "enum": ["NEW", "ATTACH", "RESUME", "READ_ONLY", "CANCEL", "RECOVER", "BLOCKED"]
    },
    "last_checkpoint": { "type": "string" },
    "checkpoint_validation": { "type": "string" },
    "approval_validation": { "type": "string" },
    "duplicate_workflow_check": { "type": "string" },
    "duplicate_orchestrator_check": { "type": "string" },
    "read_only": { "type": "boolean" },
    "raw_request_sha256": { "type": "string" },
    "created_at": { "type": "string" },
    "valid_until": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": [
        "BOOTSTRAP_READY",
        "BOOTSTRAP_READY_READ_ONLY",
        "BOOTSTRAP_BLOCKED",
        "BOOTSTRAP_INVALID"
      ]
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "const": "SHA-256" }
  },
  "additionalProperties": false
}
