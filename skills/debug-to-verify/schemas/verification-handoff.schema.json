{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Verification Handoff Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "verification_handoff_id",
    "requirement_identity",
    "blueprint_identity",
    "implementation_identity",
    "debug_identity",
    "verification_identity",
    "architecture_conformance_record",
    "verification_outcome",
    "test_status",
    "content_hash"
  ],
  "properties": {
    "verification_handoff_id": { "type": "string" },
    "requirement_identity": { "type": "object" },
    "blueprint_identity": { "type": "object" },
    "implementation_identity": { "type": "object" },
    "debug_identity": { "type": "object" },
    "verification_identity": { "type": "object" },
    "architecture_conformance_record": { "type": "object" },
    "verification_outcome": { "type": "string" },
    "test_status": { "type": "string", "default": "NOT_RUN" },
    "unverified_items": { "type": "array", "items": { "type": "string" } },
    "git_status": { "type": "string", "default": "NOT_RUN" },
    "release_readiness_candidate": { "type": "boolean", "default": false },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" }
  }
}
