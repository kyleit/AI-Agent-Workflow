{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWF Verification Session Schema",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "verification_id",
    "project_id",
    "workflow_id",
    "execution_id",
    "debug_session_id",
    "requirement_identity",
    "blueprint_identity",
    "version",
    "status",
    "static_checks",
    "build_checks",
    "test_checks",
    "acceptance_evidence",
    "test_status",
    "content_hash"
  ],
  "properties": {
    "verification_id": { "type": "string" },
    "project_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "execution_id": { "type": "string" },
    "debug_session_id": { "type": "string" },
    "requirement_identity": { "type": "object" },
    "blueprint_identity": { "type": "object" },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "ENTRY_VALIDATING",
        "EVIDENCE_COLLECTING",
        "STATIC_VERIFYING",
        "BUILD_VERIFYING",
        "TEST_AUTHORIZATION_CHECKING",
        "TESTS_NOT_AUTHORIZED",
        "TESTS_AUTHORIZED",
        "TEST_EXECUTING",
        "EVIDENCE_CONSOLIDATING",
        "INDEPENDENT_REVIEW",
        "READY_FOR_ARCHITECTURE_CONFORMANCE",
        "VERIFIED_WITHOUT_TESTS",
        "VERIFIED_WITH_FINDINGS",
        "VERIFICATION_INCOMPLETE",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "INVALIDATED",
        "SUPERSEDED"
      ]
    },
    "static_checks": { "type": "array", "items": { "type": "object" } },
    "build_checks": { "type": "array", "items": { "type": "object" } },
    "test_checks": { "type": "array", "items": { "type": "object" } },
    "acceptance_evidence": { "type": "array", "items": { "type": "object" } },
    "test_status": { "type": "string", "default": "NOT_RUN" },
    "test_execution_owner": { "type": "string", "default": "TESTER" },
    "unverified_items": { "type": "array", "items": { "type": "string" } },
    "architecture_conformance_status": { "type": "string" },
    "content_hash": { "type": "string" },
    "hash_algorithm": { "type": "string", "default": "SHA-256" }
  }
}
