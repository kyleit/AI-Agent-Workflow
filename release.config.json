{
  "project_type": "multi-module",
  "default_branch": "main",
  "remote_name": "origin",
  "modules": [
    {
      "name": "framework-core",
      "path": ".",
      "version_file": "MANIFEST.json",
      "changelog_file": "CHANGELOG.md"
    },
    {
      "name": "visualizer-extension",
      "path": "extensions/visualizer",
      "version_file": "extensions/visualizer/package.json",
      "changelog_file": "CHANGELOG.md",
      "independent_versioning": true
    }
  ],
  "version": {
    "strategy": "auto-conventional",
    "source_of_truth": "MANIFEST.json#version",
    "files": ["MANIFEST.json#version"]
  },
  "changelog": {
    "dev": { "path": "CHANGELOG.md", "include": "all" },
    "product": { "path": "public_export/CHANGELOG.md", "include": ["feat", "fix", "perf"] }
  },
  "gates": {
    "preflight": [
      { "name": "validate-skills", "cmd": "python tools/validate-skills.py" }
    ]
  },
  "pipeline": [
    { "step": "bump-version" },
    { "step": "run", "cmd": "node tools/export.js" },
    { "step": "changelog" },
    { "step": "gate", "cmd": "python tools/validate-skills.py" },
    { "step": "repo-release", "path": "public_export", "tag": "v{version}", "order": 1, "message": "feat: release version {version}", "force": true },
    { "step": "submodule-pointer", "path": "public_export" },
    { "step": "repo-release", "path": ".", "tag": "v{version}", "order": 2, "message": "chore(release): publish v{version}", "force": true },
    { "step": "run", "cmd": "aiwf update --force" }
  ],
  "receipt_dir": ".agents/state/release"
}
