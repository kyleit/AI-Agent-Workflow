#!/bin/sh
# AIWF universal source-write gate (pre-commit).
# Deterministic, tool-agnostic: blocks committing SOURCE changes unless the
# active work item has an approved AIWF blueprint. Works for ANY AI/editor
# because git runs this in the harness, not the model.
#
# Bypass (emergency/bootstrap): AIWF_BYPASS=1 git commit ...

# Disabled hooks must exit before interpreter lookup (Windows aliases may fail).
[ "${AIWF_GATE_MODE:-off}" = enforce ] || exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "$ROOT" ] && exit 0

GATE=""
for c in "$ROOT/tools/aiwf-hooks/aiwf_gate.py" "$ROOT/.agents/aiwf-hooks/aiwf_gate.py"; do
  [ -f "$c" ] && { GATE="$c"; break; }
done
[ -n "$GATE" ] || exit 0

if command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then PY=python;
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then PY=python3;
elif command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then PY=py;
else
  echo "[aiwf-gate] python not found — cannot enforce gate; allowing commit." >&2
  exit 0
fi

if [ "$PY" = py ]; then "$PY" -3 "$GATE" check-git;
else "$PY" "$GATE" check-git; fi
exit $?
