#!/bin/sh
# AIWF universal gate (pre-push) — backstop for:
#   1. source changes that bypassed pre-commit (e.g. --no-verify)
#   2. release tag (v*) pushes that did not go through the release orchestrator
# Deterministic, tool-agnostic (git runs this, not the model).
#
# Bypass (emergency): AIWF_BYPASS=1 git push ...

# Disabled hooks must exit before interpreter lookup or reading push refs.
[ "${AIWF_GATE_MODE:-off}" = enforce ] || exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "$ROOT" ] && exit 0

GATE=""
for c in "$ROOT/.agents/aiwf-hooks/aiwf_gate.py" "$ROOT/tools/aiwf-hooks/aiwf_gate.py"; do
  [ -f "$c" ] && { GATE="$c"; break; }
done
[ -n "$GATE" ] || exit 0

if command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then PY=python;
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then PY=python3;
elif command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then PY=py;
else exit 0; fi

# Read the pre-push ref lines once; reuse for both checks.
REFS="$(cat)"

# 1. Release tag backstop: v* tag must have a release receipt.
run_gate() {
  if [ "$PY" = py ]; then "$PY" -3 "$GATE" "$@";
  else "$PY" "$GATE" "$@"; fi
}
printf '%s\n' "$REFS" | run_gate check-release-tags || exit 1

# 2. Source-write backstop: Python inspects every outgoing commit/path pair.
# Names are parsed with NUL delimiters, including delete and rename endpoints.
printf '%s\n' "$REFS" | AIWF_PUSH_URL="$2" run_gate check-outgoing
exit $?
